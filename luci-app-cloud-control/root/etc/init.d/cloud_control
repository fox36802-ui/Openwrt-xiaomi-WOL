#!/bin/sh /etc/rc.common
# cloud_control —— 巴法云云端开关机守护进程的 procd 托管脚本
#
# 说明：cloud_control 以前台模式运行（不加 -d），由 procd 负责拉起与重启，
#       stdout/stderr 交给 procd 接管，崩溃后按 respawn 策略自动重启。

START=99
STOP=10

USE_PROCD=1

PROG=/usr/bin/cloud_control

start_service() {
	local enabled

	# 按「节类型」定位，而不是按节名：
	#   配置正常是 config main 'main'，但如果被写成匿名节（config main），
	#   按节名 main 取值会失败 -> 服务永远起不来，
	#   而 -t cloud 测试照样成功，表现就是「测试正常、设备不上线」。
	enabled=$(uci -q get cloud_control.@main[0].enabled)
	[ -n "$enabled" ] || enabled=$(uci -q get cloud_control.main.enabled)
	[ -n "$enabled" ] || enabled=0

	if [ "$enabled" != "1" ]; then
		logger -t cloud_control "服务未启用（enabled=0），跳过启动"
		return 0
	fi

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0"
	procd_close_instance
}

stop_service() {
	logger -t cloud_control "正在停止服务"
}

reload_service() {
	# 守护进程自身每 60 秒会复查配置，这里做一次彻底重启保证 client_id/topic
	# 变更立即生效（procd_send_signal 需要进程配合处理信号，直接重启更可靠）。
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "cloud_control"
}
